# 阿里云百炼（DashScope）— OpenAI 兼容模式
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Tavily 搜索
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# API 访问令牌（小程序请求头携带，防止接口被恶意刷量）
API_AUTH_TOKEN=change_me_to_a_random_string

# MySQL（任务持久化与推荐食谱存储）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fitness_db

# （可选）USDA FoodData Central（本地热量表未命中时的兜底数据源）
# 免费注册：https://fdc.nal.usda.gov/api-key-signup.html
# USDA_API_KEY=your_usda_api_key

# （阶段二可选）LangSmith 链路追踪
# LANGSMITH_API_KEY=your_api_key_here
# LANGSMITH_TRACING=true
