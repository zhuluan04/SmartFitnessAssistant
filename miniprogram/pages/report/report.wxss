/* pages/report/report.wxss - 报告页样式（卡片式） */

.page-container {
  padding-bottom: 40rpx;
}

/* 总热量主视觉 */
.hero-card {
  margin: 24rpx;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #4ECDC4, #2BA89C);
  color: #FFFFFF;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(78, 205, 196, 0.3);
}

.hero-label {
  font-size: 26rpx;
  opacity: 0.85;
}

.hero-value {
  font-size: 84rpx;
  font-weight: 700;
  line-height: 1.2;
  margin: 12rpx 0;
}

.hero-unit {
  font-size: 30rpx;
  font-weight: 400;
  margin-left: 8rpx;
}

.hero-basis {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 异常提示 */
.warn-bar {
  margin: 0 24rpx 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #FFF8E6;
  color: #B7791F;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 食谱卡片 */
.recipe-card {
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(78, 205, 196, 0.08);
}

.recipe-head {
  display: flex;
  align-items: center;
}

.recipe-idx {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #E8F5F0;
  color: #2BA89C;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.recipe-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3436;
}

.recipe-meta {
  display: flex;
  align-items: baseline;
  margin: 20rpx 0 16rpx;
}

.recipe-cal {
  font-size: 44rpx;
  font-weight: 700;
  color: #2BA89C;
}

.recipe-cal .unit {
  font-size: 24rpx;
  font-weight: 400;
  margin-left: 6rpx;
}

.recipe-protein {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #636E72;
}

.recipe-reason {
  font-size: 26rpx;
  color: #4A5568;
  line-height: 1.7;
  padding: 16rpx 20rpx;
  background: #F7FAFC;
  border-radius: 12rpx;
}

/* 做法步骤 */
.steps {
  margin-top: 20rpx;
}

.step {
  display: flex;
  align-items: flex-start;
  margin-top: 14rpx;
}

.step-dot {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: #E8F5F0;
  color: #2BA89C;
  font-size: 20rpx;
  margin-right: 14rpx;
}

.step-text {
  flex: 1;
  font-size: 26rpx;
  color: #2D3436;
  line-height: 1.6;
}

/* 食材明细行 */
.item-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EDF2F7;
}

.item-row:last-child {
  border-bottom: none;
}

.item-name {
  flex: 1;
  font-size: 28rpx;
  color: #2D3436;
}

.item-grams {
  font-size: 26rpx;
  color: #636E72;
  margin-right: 24rpx;
}

.item-kcal {
  font-size: 26rpx;
  font-weight: 600;
  color: #2BA89C;
}

.tag-est {
  font-size: 20rpx;
  color: #B7791F;
  background: #FFF8E6;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}

/* 小贴士 */
.tip {
  font-size: 26rpx;
  color: #4A5568;
  line-height: 1.8;
}

/* 空状态 */
.empty-card {
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: #636E72;
}

/* 兜底原文 */
.raw-text {
  display: block;
  font-size: 26rpx;
  color: #2D3436;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 调试信息 */
.debug-toggle {
  margin: 0 24rpx 16rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #A0AEC0;
  background: #F7FAFC;
  border-radius: 12rpx;
}

.debug-panel {
  margin: 0 24rpx 24rpx;
  padding: 20rpx 24rpx;
  background: #F7FAFC;
  border-radius: 12rpx;
}

.debug-line {
  font-size: 22rpx;
  color: #636E72;
  line-height: 1.8;
  word-break: break-all;
}

/* 操作按钮组 */
.action-group {
  padding: 24rpx;
}

.btn-secondary {
  background: #FFFFFF;
  color: #4ECDC4;
  border: 2rpx solid #4ECDC4;
  border-radius: 48rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-top: 20rpx;
}
