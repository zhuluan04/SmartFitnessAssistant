/* pages/index/index.wxss - 首页样式 */

.page-container {
  padding-bottom: 40rpx;
}

.input-area {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #2D3436;
  border: none;
}

/* 图片上传区 */
.image-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  border: 2rpx dashed #4ECDC4;
  border-radius: 16rpx;
  margin-top: 24rpx;
  background: #F0FFF9;
}

.upload-icon {
  font-size: 48rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #636E72;
  margin-top: 8rpx;
}

/* 图片预览 */
.image-preview {
  position: relative;
  margin-top: 24rpx;
}

.preview-img {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
}

.remove-btn {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 健身目标选择 */
.goal-group {
  display: flex;
  gap: 20rpx;
}

.goal-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 32rpx;
  font-size: 28rpx;
  background: #F0FFF9;
  color: #636E72;
  border: 2rpx solid #E8F5F0;
  transition: all 0.2s;
}

.goal-item.active {
  background: #4ECDC4;
  color: #FFFFFF;
  border-color: #4ECDC4;
}

/* 提交按钮 */
.submit-btn {
  margin: 32rpx 24rpx;
}

/* 分析中遮罩：骨架卡片 + 旋转指示器 + 进度条 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(45, 52, 54, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-card {
  width: 520rpx;
  padding: 56rpx 40rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 40rpx rgba(78, 205, 196, 0.25);
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #E8F5F0;
  border-top-color: #4ECDC4;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-stage {
  margin-top: 32rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3436;
}

.progress-track {
  width: 100%;
  height: 10rpx;
  margin-top: 28rpx;
  border-radius: 5rpx;
  background: #EDF2F7;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #4ECDC4, #2BA89C);
  transition: width 0.6s ease;
}

.loading-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #A0AEC0;
}
